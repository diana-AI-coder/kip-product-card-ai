# Универсальный OpenAI-compatible провайдер.
# Скопируйте этот файл в .env и заполните значения. .env в .gitignore.

# OpenAI
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# OpenRouter: https://openrouter.ai/api/v1
# Groq:       https://api.groq.com/openai/v1
# Ollama:     http://localhost:11434/v1   (ключ может быть любым, например ollama)

LLM_API_KEY=sk-your-key-here

LLM_TIMEOUT=60
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2000
# auto | schema | object | prompt
LLM_JSON_MODE=auto
LLM_MAX_REPAIRS=1
